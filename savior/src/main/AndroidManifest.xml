<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Las consultas DNS se reenvían a un resolutor con filtro familiar. Es
         lo único que sale del teléfono. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Mirar las redes en uso para que la subred del túnel no se pise con la real. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Volver a levantar el filtro tras reiniciar. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Servicio en primer plano con notificación fija: es lo que impide que el
         sistema mate el filtro al cerrar la app o al ahorrar memoria. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Cliente ADB propio (depuración inalámbrica): buscar el servicio en la red local. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Sólo se concede por ADB (pm grant). Con él la app reenciende su propia accesibilidad. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Qué apps son navegadores (ver guard/Browsers.kt). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <!-- Opcional: que el sistema no duerma el filtro para ahorrar batería. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecretSavior">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Filtro DNS: una VPN local que sólo captura las consultas DNS. -->
        <service
            android:name=".vpn.SaviorVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Filtro DNS local que bloquea sitios para adultos" />
        </service>

        <!-- Guardián: vigila las pantallas que permitirían apagar la protección
             y el texto explícito. -->
        <service
            android:name=".guard.GuardService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard_service" />
        </service>

        <!-- Resurrección: Android vuelve a enlazar este servicio tras forzar la detención de
             la app, y con él arranca todo lo demás. No lee notificaciones. -->
        <service
            android:name=".guard.ReviveListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Mientras sea administrador del dispositivo, Android se niega a
             desinstalar la app. -->
        <receiver
            android:name=".guard.AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Vincular sin ordenador: recibe el código de la notificación con campo de respuesta
             (provision/Provisioner.kt). Sólo lo llama el sistema con un intent explícito. -->
        <receiver
            android:name=".provision.ProvisionReceiver"
            android:exported="false" />

        <receiver
            android:name=".guard.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- El «arranque rápido» de algunos fabricantes no emite BOOT_COMPLETED. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
